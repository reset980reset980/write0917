# 복사해서 server/.env 로 저장한 뒤 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)

PORT=3917
HOST=127.0.0.1

# 미니PC PostgreSQL
DATABASE_URL=postgres://write0917:비밀번호@127.0.0.1:5432/write0917

# 화면(Vercel) 주소. 여러 개면 쉼표로 구분
ALLOWED_ORIGINS=https://write0917.vercel.app

# 선생님 계정
ADMIN_USERNAME=admin
# npm run hash-password -- '비밀번호' 로 만든 값
ADMIN_PASSWORD_HASH=
# 아무 긴 랜덤 문자열 (예: openssl rand -hex 32)
TOKEN_SECRET=
TOKEN_TTL_HOURS=12

# Gemini (서버에만 보관)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
